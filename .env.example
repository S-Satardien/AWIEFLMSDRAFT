# -----------------------------------------------------------------------------
# AWIEF Digital Learning Academy — Environment Configuration Template
# -----------------------------------------------------------------------------

# 1. Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# 2. Production Cloud Deployment (Neon PostgreSQL / Supabase / Vercel Postgres):
# Replace DATABASE_URL with your Neon pooled connection string:
# DATABASE_URL="postgresql://neondb_owner:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 3. NextAuth Configuration:
# Local dev: http://localhost:3000
# Production: https://academy.awieforum.org (or your Vercel URL e.g. https://awief-lms.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="awief-super-secure-production-secret-change-me"

