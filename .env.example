# Database Connection
# Local SQLite: "file:./dev.db"
# Production PostgreSQL: "postgresql://user:password@host/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# NextAuth Core Secret (generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET="replace-with-64-char-random-hex"
NEXTAUTH_URL="http://localhost:3000"

# Dedicated 256-bit Field-Level PII Encryption Key (recommended for production key separation)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=""

# Dedicated HMAC-SHA256 Key for Verifiable QR Certificate Signatures
CERTIFICATE_SIGNING_KEY=""

# Set to "true" ONLY on staging/demo deployments for reviewer 1-click access.
# Omit or set to "false" before opening to public users.
ENABLE_DEMO_LOGIN="false"
